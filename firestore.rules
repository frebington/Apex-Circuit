rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 3 && id.size() <= 160 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidTrackId(trackId) {
      return trackId is string && trackId in [
        'alpine_gorge',
        'redrock_crossing',
        'frostpeak_pass',
        'coastal_causeway',
        'sunset_valley'
      ];
    }

    function isValidChassisId(chassisId) {
      return chassisId is string && chassisId in [
        'gt_coupe',
        'formula_open',
        'rally_hatch',
        'hyper_prototype'
      ];
    }

    function isValidPaintFinish(paintFinish) {
      return paintFinish is string && paintFinish in [
        'gloss',
        'metallic',
        'matte',
        'chrome'
      ];
    }

    function isValidLapRecord(data) {
      return data.keys().hasAll([
          'uid',
          'driverName',
          'trackId',
          'bestLapMs',
          'chassisId',
          'paintFinish',
          'color',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'driverName',
          'trackId',
          'bestLapMs',
          'chassisId',
          'paintFinish',
          'color',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.driverName is string &&
        data.driverName.size() >= 1 &&
        data.driverName.size() <= 16 &&
        isValidTrackId(data.trackId) &&
        data.bestLapMs is int &&
        data.bestLapMs >= 5000 &&
        data.bestLapMs <= 600000 &&
        isValidChassisId(data.chassisId) &&
        isValidPaintFinish(data.paintFinish) &&
        data.color is string &&
        data.color.size() == 7 &&
        data.color.matches('^#[0-9a-fA-F]{6}$') &&
        data.updatedAt is timestamp;
    }

    function isValidDailyChallengeProgress(data) {
      return data.keys().hasAll([
          'uid',
          'currentStreak',
          'bestStreak',
          'totalCompleted',
          'lastCompletedDate',
          'unlockedLiveryIds',
          'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid',
          'currentStreak',
          'bestStreak',
          'totalCompleted',
          'lastCompletedDate',
          'unlockedLiveryIds',
          'updatedAt'
        ]) &&
        data.uid is string &&
        data.uid.size() >= 1 &&
        data.uid.size() <= 128 &&
        data.uid == request.auth.uid &&
        data.currentStreak is int &&
        data.currentStreak >= 1 &&
        data.currentStreak <= 3650 &&
        data.bestStreak is int &&
        data.bestStreak >= data.currentStreak &&
        data.bestStreak <= 3650 &&
        data.totalCompleted is int &&
        data.totalCompleted >= 1 &&
        data.totalCompleted <= 3650 &&
        data.lastCompletedDate is string &&
        data.lastCompletedDate.size() == 10 &&
        data.lastCompletedDate.matches('^\\d{4}-\\d{2}-\\d{2}$') &&
        data.unlockedLiveryIds is list &&
        data.unlockedLiveryIds.size() >= 1 &&
        data.unlockedLiveryIds.size() <= 8 &&
        data.unlockedLiveryIds[0] is string &&
        data.unlockedLiveryIds.hasOnly([
          'rosso_neon',
          'hyper_cyan',
          'acid_lime',
          'royal_violet',
          'papaya_orange',
          'petronas_teal',
          'bwt_magenta',
          'championship_gold'
        ]) &&
        data.updatedAt is timestamp;
    }

    // Public non-PII global leaderboard keyed by {uid}_{trackId}
    match /lapRecords/{recordId} {
      allow get: if isValidId(recordId) &&
        isValidTrackId(existing().trackId) &&
        existing().bestLapMs is int &&
        existing().bestLapMs >= 5000;

      allow list: if existing().bestLapMs >= 5000 &&
        existing().bestLapMs <= 600000;

      allow create: if isVerifiedUser() &&
        isValidId(recordId) &&
        isValidLapRecord(incoming()) &&
        recordId == (request.auth.uid + '_' + incoming().trackId) &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(recordId) &&
        isValidLapRecord(incoming()) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().trackId == existing().trackId &&
        incoming().bestLapMs < existing().bestLapMs &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'driverName',
          'bestLapMs',
          'chassisId',
          'paintFinish',
          'color',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(recordId) &&
        existing().uid == request.auth.uid;
    }

    // Owner-only daily challenge streaks and unlocked reward liveries
    match /dailyChallenges/{userId} {
      allow get: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        (resource == null || existing().uid == request.auth.uid);

      allow list: if false;

      allow create: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidDailyChallengeProgress(incoming()) &&
        incoming().currentStreak == 1 &&
        incoming().bestStreak == 1 &&
        incoming().totalCompleted == 1 &&
        incoming().unlockedLiveryIds.size() == 1 &&
        incoming().updatedAt == request.time;

      allow update: if isVerifiedUser() &&
        isValidId(userId) &&
        userId == request.auth.uid &&
        isValidDailyChallengeProgress(incoming()) &&
        existing().uid == request.auth.uid &&
        incoming().uid == existing().uid &&
        incoming().lastCompletedDate > existing().lastCompletedDate &&
        incoming().currentStreak <= existing().currentStreak + 1 &&
        incoming().totalCompleted == existing().totalCompleted + 1 &&
        incoming().bestStreak >= existing().bestStreak &&
        incoming().bestStreak >= incoming().currentStreak &&
        incoming().unlockedLiveryIds.hasAll(existing().unlockedLiveryIds) &&
        incoming().unlockedLiveryIds.size() <= existing().unlockedLiveryIds.size() + 1 &&
        incoming().updatedAt == request.time &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'currentStreak',
          'bestStreak',
          'totalCompleted',
          'lastCompletedDate',
          'unlockedLiveryIds',
          'updatedAt'
        ]);

      allow delete: if isVerifiedUser() &&
        isValidId(userId) &&
        existing().uid == request.auth.uid;
    }
  }
}
